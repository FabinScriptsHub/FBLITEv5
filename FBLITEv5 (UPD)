local function createButton(text,x,y)

local button = Instance.new("TextButton")
button.Parent = main
button.Position = UDim2.new(0,x,0,y)
button.Size = UDim2.new(0,200,0,35)
button.BackgroundColor3 = Color3.fromRGB(30,60,30)
