-- ANTI LAG MAX
local function AntiLag(removeSkins)
task.spawn(function()

pcall(function()
settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
end)

pcall(function()
if Terrain then
Terrain.WaterWaveSize = 0
Terrain.WaterWaveSpeed = 0
Terrain.WaterReflectance = 0
Terrain.WaterTransparency = 1
end
end)

pcall(function()
Lighting.GlobalShadows = false
Lighting.Brightness = 0
Lighting.FogEnd = 9e9
end)

for _,v in ipairs(Lighting:GetChildren()) do
if v:IsA("PostEffect") or v:IsA("Sky") or v:IsA("Atmosphere") then
v:Destroy()
end
end

for i,v in ipairs(workspace:GetDescendants()) do
pcall(function()

if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then    
v:Destroy()    
end    

if v:IsA("ParticleEmitter") then v.Enabled = false end    
if v:IsA("Trail") then v.Enabled = false end    
if v:IsA("Smoke") or v:IsA("Fire") then v.Enabled = false end    

if v:IsA("Decal") then v:Destroy() end    
if v:IsA("Texture") then v:Destroy() end    

if v:IsA("BasePart") then    
v.Material = Enum.Material.SmoothPlastic    
v.CastShadow = false    
v.Reflectance = 0    
end    

if v:IsA("SurfaceAppearance") then v:Destroy() end    
if v:IsA("Beam") then v:Destroy() end    

if v:IsA("UnionOperation") then v:Destroy() end    

if v:IsA("MeshPart") then v.TextureID = "" end    

if v:IsA("Sound") then v:Destroy() end    

if i % 500 == 0 then task.wait() end    
end)
end

pcall(function()
for _,v in pairs(getconnections(game:GetService("RunService").RenderStepped)) do
v:Disable()
end
end)

pcall(function()
player.CameraMaxZoomDistance = 20
player.CameraMinZoomDistance = 5
end)

pcall(function()
settings().Rendering.FrameRateManager = Enum.FrameRateManagerMode.Fixed
end)

-- PLAYERS
for _,plr in ipairs(game.Players:GetPlayers()) do
if plr.Character then
for _,charObj in ipairs(plr.Character:GetDescendants()) do

if charObj:IsA("Accessory") then charObj:Destroy() end    

if removeSkins then    
if charObj:IsA("Shirt") or charObj:IsA("Pants") or charObj:IsA("ShirtGraphic") then charObj:Destroy() end    
if charObj:IsA("CharacterMesh") then charObj:Destroy() end    
if charObj:IsA("SpecialMesh") then charObj.TextureId = "" end    
if charObj:IsA("Decal") then charObj:Destroy() end    
end    

end    
end
end

-- NPCs
if removeSkins then
for _, npc in ipairs(workspace:GetDescendants()) do
pcall(function()
if npc:IsA("Model") and npc:FindFirstChildOfClass("Humanoid") and not game.Players:GetPlayerFromCharacter(npc) then
for _, obj in ipairs(npc:GetDescendants()) do
if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then obj:Destroy() end
if obj:IsA("CharacterMesh") then obj:Destroy() end
if obj:IsA("Decal") then obj:Destroy() end
if obj:IsA("Texture") then obj:Destroy() end
if obj:IsA("SpecialMesh") then obj.TextureId = "" end
if obj:IsA("MeshPart") then obj.TextureID = "" end
end
end
end)
end
end

if Terrain then
